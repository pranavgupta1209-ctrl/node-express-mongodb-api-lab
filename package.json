  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "nodemon": {
      "chokidar": "^4.0.3",
      "minimatch": "^11.0.9"
