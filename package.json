  "description": "An introductory Express API with MongoDB user registration and post CRUD operations.",
  "main": "backend/src/index.js",
  "type": "module",
  "scripts": {
    "start": "node backend/src/index.js",
    "dev": "nodemon --watch backend/src --ext js backend/src/index.js",
    "test": "node --test --test-concurrency=1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
